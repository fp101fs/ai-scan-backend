# NextAuth Secret for JWT signing (generate with: openssl rand -base64 32)
AUTH_SECRET=your-secure-random-auth-secret
NEXTAUTH_SECRET=your-secure-random-auth-secret
NEXTAUTH_URL=http://localhost:3000

# OpenRouter Configuration
# Users authenticate & supply keys via OpenRouter OAuth (PKCE) by default (BYOK).
# Set this server key as an optional fallback for unauthenticated demo requests:
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: Google OAuth (if enabling secondary Google sign-in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
